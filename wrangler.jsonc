{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aluvantisblog",
  "main": "worker.ts",
  "compatibility_date": "2024-09-25",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "workers_dev": true,
  "routes": [
    { "pattern": "blog.aluvantis.uz", "custom_domain": true }
  ],
  "vars": {
    "APP_URL": "https://blog.aluvantis.uz"
  },
  "kv_namespaces": [
    {
      "binding": "BLOG_STORE",
      "id": "13505521e8ba401792b2443d257dc7a9"
    }
  ]
}
