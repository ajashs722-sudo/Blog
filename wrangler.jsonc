{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aluvantisblog",
  "main": "worker.ts",
  "compatibility_date": "2024-09-25",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "vars": {
    "APP_URL": "https://aluvantisblog.mirhamd112.workers.dev"
  },
  "kv_namespaces": [
    {
      "binding": "BLOG_STORE",
      "id": "13505521e8ba401792b2443d257dc7a9"
    }
  ]
}
